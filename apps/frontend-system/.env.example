# Frontend (Next.js)
#
# Salin jadi .env lalu isi.

# Dilihat browser. Sengaja berupa jalur relatif, BUKAN alamat backend:
# panggilan API dilewatkan rewrites() Next.js supaya cookie sesi tetap
# same-origin. Jangan diisi alamat backend langsung.
NEXT_PUBLIC_API_URL=/api

# Dipakai Server Component saat memanggil API dari sisi server.
SERVER_API_URL=http://localhost:6500/api/

# Tujuan rewrites() di next.config.ts. Tanpa ini, 'localhost' akan menunjuk ke
# container frontend itu sendiri saat di-deploy dan seluruh API mati.
# Di satu VPS: http://api:6500 (nama service docker-compose).
BACKEND_URL=http://localhost:6500

PORT=3000

# ------------------------------------------------------------- Midtrans -----
# Client key boleh terlihat browser. Server key TIDAK boleh ada di berkas ini.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# Sandbox : https://app.sandbox.midtrans.com/snap/snap.js
# Produksi: https://app.midtrans.com/snap/snap.js
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
