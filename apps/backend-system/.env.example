# Backend (NestJS)
#
# Salin jadi .env lalu isi. Nilai di sini contoh, bukan rahasia sungguhan.
# Aplikasi menolak start kalau ada yang wajib tapi kosong — lihat
# src/common/config/env.schema.ts untuk aturan lengkapnya.

# ---------------------------------------------------------------- Dasar ----
NODE_ENV=development
PORT=6500

# ------------------------------------------------------------- Database ----
DATABASE_URL="postgresql://postgres:password@127.0.0.1:7000/nurfa?schema=public"

# ------------------------------------------------------------------ Auth ----
# WAJIB minimal 32 karakter saat NODE_ENV=production.
# Buat yang baru: openssl rand -base64 48
JWT_SECRET="ganti-dengan-kunci-acak-panjang-minimal-32-karakter"
JWT_EXPIRES_IN="15m"

# Kosongkan saja — mengikuti NODE_ENV, dan itu hampir selalu benar.
# Tidak boleh false saat produksi: cookie sesi akan ikut terkirim tanpa HTTPS.
# COOKIE_SECURE=true

# --------------------------------------------------------------- Jaringan ---
# Alamat frontend. Dipakai untuk tautan di email dan sebagai origin CORS
# bawaan bila CORS_ORIGINS kosong.
FRONTEND_URL="http://localhost:3000"

# Beberapa origin dipisah koma. Wildcard (*) tidak didukung — API ini
# mengirim cookie sesi.
# CORS_ORIGINS="https://nurfacraft.com,https://admin.nurfacraft.com"

# Jumlah proxy di depan backend, BUKAN sakelar nyala/mati.
# 1 = hanya rewrites() Next.js. Naikkan bila ada Traefik/Caddy di depannya.
# Salah isi = rate limiting menganggap semua pengunjung satu orang.
TRUST_PROXY_HOPS=1

# --------------------------------------------------------------- Midtrans ---
# WAJIB true saat NODE_ENV=production — kunci sandbox tidak bisa memproses
# pembayaran sungguhan, dan kegagalannya tidak terlihat sampai ada komplain.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_API_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"

# ------------------------------------------------------------- Cloudinary ---
CLOUDINARY_NAME="nama-cloud-anda"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="rahasia-cloudinary"

# ------------------------------------------------------------------ Email ---
# Opsional. Tanpa ketiganya (HOST/USER/PASS) fitur email mati, sisa aplikasi
# tetap jalan. Untuk Gmail pakai App Password, bukan kata sandi akun.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="akun@gmail.com"
SMTP_PASS="app-password-16-karakter"
SMTP_FROM="\"Nurfa Craft\" <no-reply@nurfacraft.com>"

# ------------------------------------------------------------------- Log ----
# fatal | error | warn | info | debug | trace
# Kosongkan: info di produksi, debug di development.
# LOG_LEVEL=info
