// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id       BigInt  @id @default(autoincrement())
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)
  /// Menandai toko yang stoknya dijual di storefront.
  ///
  /// Sengaja menyatakan kemampuan ("boleh dijual online"), bukan identitas
  /// ("toko utama"), supaya menambah toko lain sebagai sumber online kelak
  /// cukup dengan mengubah data — bukan menyisir kode yang terlanjur
  /// mengasumsikan sumbernya tunggal. Untuk sekarang dibatasi tepat satu toko
  /// lewat partial unique index di migrasi.
  isOnlineSource Boolean @default(false)
  /// Menandai tempat hasil produksi mendarat dan titik sebar distribusi.
  ///
  /// Sengaja terpisah dari `isOnlineSource`: yang satu soal "stoknya dijual di
  /// storefront", yang ini soal "produksi bermuara ke sini". Hari ini keduanya
  /// kebetulan menempel pada toko yang sama, tapi itu kebetulan — bukan sifat
  /// yang boleh diandalkan kode.
  isProductionHouse Boolean  @default(false)
  createdAt         DateTime @default(now())

  users                Users[]
  inventoryLedgers     InventoryLedger[]
  expenses             Expense[]
  posTransactions      PosTransaction[]
  cashTransactions     CashTransaction[]
  orders               Order[]
  productVariantStocks ProductVariantStock[]
  transfersOut         StockTransfer[]       @relation("TransferFrom")
  transfersIn          StockTransfer[]       @relation("TransferTo")
  paymentMethods       PaymentMethod[]
  stockAdjustments     StockAdjustment[]

  @@map("store")
}

model Users {
  id           BigInt   @id @default(autoincrement())
  storeId      BigInt?
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  refreshToken String?
  slug         String?  @db.VarChar(255)

  store              Store?              @relation(fields: [storeId], references: [id])
  employees          Employee?
  customer           Customer?
  posTransactions      PosTransaction[]
  orders               Order[]
  expenses             Expense[]
  productionDeliveries ProductionDelivery[]
  stockTransfers       StockTransfer[]
  stockAdjustments     StockAdjustment[]
  blogs                Blog[]
  passwordResetCodes PasswordResetCode[]

  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  KASIR
  GUDANG
  CUSTOMER
}

model Categories {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(100)
  status      Boolean  @default(true)
  slug        String   @unique @db.VarChar(100)
  createdAt   DateTime @default(now())

  productMasters ProductMaster[]

  @@map("categories")
}

model ProductMaster {
  id          BigInt        @id @default(autoincrement())
  name        String        @db.VarChar(255)
  description String?
  categoryId  BigInt?
  slug        String        @unique @db.VarChar(255)
  useVariant  Boolean       @default(false)
  type        ProductType   @default(REGULAR)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  variants              ProductVariant[]
  variantTypes          ProductVariantType[]
  categories            Categories?             @relation(fields: [categoryId], references: [id])
  imageGroups           ProductImageGroup[]
  wishlists             Wishlist[]
  productPreOrderDetail ProductPreOrderDetails?
  bespokeOrders         BespokeOrder[]

  @@map("product_master")
}

model ProductPreOrderDetails {
  id              BigInt   @id @default(autoincrement())
  productMasterId BigInt   @unique
  quotaTarget     Int
  maxQuota        Int
  endDate         DateTime @default(now())

  productMaster ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: Cascade)

  @@map("product_pre_order_details")
}

enum ProductStatus {
  ACTIVE
  NONACTIVE
  DRAFT
}

/**
 * Cara produk dijual — bukan salurannya.
 *
 * Dulu ada READY_STOCK dan MADE_TO_ORDER, yang sebenarnya membedakan SALURAN
 * (kasir vs online), bukan produknya: admin terpaksa membuat dua produk kembar
 * untuk barang yang sama. Sekarang saluran ditentukan konteks — kasir menjual
 * dari stok toko, pesanan online selalu permintaan ke rumah produksi — jadi
 * keduanya digabung jadi REGULAR. PRE_ORDER tetap terpisah karena punya aturan
 * sendiri: kuota dan tanggal berakhir.
 */
enum ProductType {
  REGULAR
  PRE_ORDER
}

/// Satu grup gambar per kombinasi nilai variant yang bersifat visual.
/// Signature adalah JSON kanonik pasangan [namaTipe, namaNilai] tipe visual,
/// terurut menurut nama tipe. '[]' berarti grup level produk: produk tanpa
/// tipe visual, atau useVariant = false.
model ProductImageGroup {
  id              BigInt   @id @default(autoincrement())
  productMasterId BigInt
  signature       String   @db.VarChar(1000)
  createdAt       DateTime @default(now())

  productMaster ProductMaster            @relation(fields: [productMasterId], references: [id], onDelete: Cascade)
  values        ProductImageGroupValue[]
  images        ProductImage[]
  variants      ProductVariant[]

  @@unique([productMasterId, signature])
  @@index([productMasterId])
  @@map("product_image_group")
}

/// Turunan dari signature, disimpan supaya grup bisa di-join dan diberi label
/// tanpa mem-parse signature.
model ProductImageGroupValue {
  imageGroupId   BigInt
  variantValueId BigInt

  imageGroup   ProductImageGroup   @relation(fields: [imageGroupId], references: [id], onDelete: Cascade)
  variantValue ProductVariantValue @relation(fields: [variantValueId], references: [id], onDelete: Cascade)

  @@id([imageGroupId, variantValueId])
  @@index([variantValueId])
  @@map("product_image_group_value")
}

model ProductImage {
  id           BigInt   @id @default(autoincrement())
  imageGroupId BigInt
  image        String   @db.VarChar(500)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  imageGroup ProductImageGroup @relation(fields: [imageGroupId], references: [id], onDelete: Cascade)

  @@index([imageGroupId, sortOrder])
  @@map("product_image")
}

model ProductVariant {
  id              BigInt   @id @default(autoincrement())
  productMasterId BigInt
  sku             String   @unique @db.VarChar(100)
  price           Decimal  @db.Decimal(18, 2)
  cost            Decimal? @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  imageGroupId    BigInt?
  createdAt       DateTime @default(now())

  productMaster        ProductMaster          @relation(fields: [productMasterId], references: [id], onDelete: Cascade)
  imageGroup           ProductImageGroup?     @relation(fields: [imageGroupId], references: [id], onDelete: SetNull)
  options              ProductVariantOption[]
  /// Jamak sejak stok dipegang per toko: satu baris per toko yang memegang
  /// varian ini.
  productVariantStocks ProductVariantStock[]
  productionItems      ProductionItem[]
  orderItems           OrderItem[]
  posTransactionItems  PosTransactionItem[]
  stockTransferItems   StockTransferItem[]
  cartItems            CartItem[]

  @@index([productMasterId])
  @@index([imageGroupId])
  @@map("product_variant")
  stockAdjustmentItems StockAdjustmentItem[]
}

/// Stok dipegang per toko: satu baris untuk tiap pasangan varian dan toko.
///
/// Sebelumnya `productVariantId` bertanda `@unique`, sehingga satu varian hanya
/// punya satu angka stok untuk seluruh perusahaan — kasir cabang yang menjual
/// akan mengurangi stok yang sama dengan toko utama. Keunikan gabungan di bawah
/// yang membuat tiap toko memegang stoknya sendiri.
model ProductVariantStock {
  id               BigInt   @id @default(autoincrement())
  productVariantId BigInt
  storeId          BigInt
  stock            Int
  reserved_stock   Int
  updated_at       DateTime @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id])

  @@unique([productVariantId, storeId])
  @@index([storeId])
  @@map("product_variant_stock")
}

model ProductVariantType {
  id              BigInt  @id @default(autoincrement())
  productMasterId BigInt
  name            String  @db.VarChar(255)
  isHaveVisual    Boolean @default(false)

  productMaster ProductMaster         @relation(fields: [productMasterId], references: [id], onDelete: Cascade)
  values        ProductVariantValue[]

  @@unique([productMasterId, name])
  @@index([productMasterId])
  @@map("product_variant_type")
}

model ProductVariantValue {
  id            BigInt @id @default(autoincrement())
  variantTypeId BigInt
  value         String @db.VarChar(100)

  variantType      ProductVariantType       @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)
  options          ProductVariantOption[]
  imageGroupValues ProductImageGroupValue[]

  @@unique([variantTypeId, value])
  @@index([variantTypeId])
  @@map("product_variant_value")
}

model ProductVariantOption {
  id               BigInt @id @default(autoincrement())
  productVariantId BigInt
  variantValueId   BigInt

  productVariant ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  variantValue   ProductVariantValue @relation(fields: [variantValueId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, variantValueId])
  @@index([productVariantId])
  @@index([variantValueId])
  @@map("product_variant_option")
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(255)
  image     String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  userId            BigInt?           @unique
  users             Users?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            Order[]
  bespokeOrders     BespokeOrder[]
  cart              Cart?
  customerAddresses CustomerAddress[]
  wishlists         Wishlist[]

  @@map("customer")
}

model PasswordResetCode {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt
  codeHash  String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_code")
}

model Employee {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(15)
  createdAt DateTime @default(now())
  image     String?  @db.VarChar(255)

  users  Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId BigInt @unique

  @@map("employee")
}

// ==================
// Inventory Ledger
// ==================

/**
 * Penyesuaian stok — satu kali pencatatan untuk banyak varian sekaligus.
 *
 * Dibutuhkan karena seluruh jalur stok lain adalah akibat dari kejadian lain
 * (produksi, penjualan, kiriman). Stok awal saat sistem mulai dipakai, barang
 * rusak, hilang, atau salah hitung saat opname tidak punya kejadian seperti
 * itu — tanpa tabel ini, satu-satunya cara membetulkan angka adalah memalsukan
 * transaksi.
 *
 * Alasan dan pencatatnya disimpan di sini, bukan di `InventoryLedger`, supaya
 * tabel riwayat tetap seragam untuk semua sumber. Baris riwayatnya menunjuk
 * ke sini lewat `referenceId`.
 */
model StockAdjustment {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(100)
  storeId   BigInt
  /// Wajib diisi: angka stok yang berubah tanpa keterangan tidak bisa
  /// ditelusuri lagi setelah beberapa bulan.
  reason    String
  userId    BigInt?
  createdAt DateTime @default(now())

  store Store  @relation(fields: [storeId], references: [id])
  user  Users? @relation(fields: [userId], references: [id])
  items StockAdjustmentItem[]

  @@index([storeId])
  @@map("stock_adjustment")
}

model StockAdjustmentItem {
  id               BigInt @id @default(autoincrement())
  adjustmentId     BigInt
  productVariantId BigInt
  /// Angka sebelum dan sesudah disimpan apa adanya, bukan cuma selisihnya:
  /// itu yang memungkinkan koreksi ditelusuri ulang tanpa menghitung mundur
  /// seluruh riwayat.
  previousStock    Int
  countedStock     Int

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [productVariantId], references: [id])

  @@unique([adjustmentId, productVariantId])
  @@map("stock_adjustment_item")
}

model InventoryLedger {
  id          BigInt            @id @default(autoincrement())
  storeId     BigInt
  itemType    InventoryItemType
  itemId      BigInt
  direction   LedgerDirection
  source      LedgerSource
  quantity    Int
  referenceId BigInt?
  createdAt   DateTime          @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, itemType, itemId])
  @@map("inventory_ledger")
}

enum InventoryItemType {
  PRODUCT_VARIANT
}

enum LedgerDirection {
  IN
  OUT
}

enum LedgerSource {
  PRODUCTION
  POS
  ONLINE_ORDER
  ADJUSTMENT
  TRANSFER
}

/// Perpindahan stok antar lokasi.
///
/// Dicatat dua tahap, bukan sekali pindah: stok keluar dari asal saat dikirim,
/// dan baru masuk ke tujuan saat penerimaan dikonfirmasi. Selisih di antaranya
/// adalah barang yang sedang di jalan. Tanpa pemisahan ini, kasir cabang bisa
/// menjual barang yang secara fisik masih dalam perjalanan — dan pengiriman ke
/// luar kota bisa memakan waktu lama.
model StockTransfer {
  id     BigInt @id @default(autoincrement())
  code   String @unique @db.VarChar(100)
  status TransferStatus @default(READY)

  fromStoreId BigInt
  toStoreId   BigInt
  /// Karyawan yang mengurus kiriman ini. Boleh kosong untuk kiriman lama yang
  /// dibuat sebelum kolom ini ada — data lama tidak diisi dengan tebakan.
  userId BigInt?

  notes      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  receivedAt DateTime?

  fromStore  Store       @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore    Store       @relation("TransferTo", fields: [toStoreId], references: [id])
  user       Users?      @relation(fields: [userId], references: [id])

  items StockTransferItem[]

  @@index([status])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("stock_transfer")
}

model StockTransferItem {
  id               BigInt @id @default(autoincrement())
  transferId       BigInt
  productVariantId BigInt
  quantity         Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([transferId, productVariantId])
  @@map("stock_transfer_item")
}

enum TransferStatus {
  /// Sudah dicatat, barang masih di asal.
  READY
  /// Sudah berangkat: stok keluar dari asal, belum masuk ke tujuan.
  SENT
  RECEIVED
  CANCELLED
}

// ==================
// PRODUKSI INTERNAL
// ==================

/// Batch produksi.
///
/// Satu batch memuat banyak varian sekaligus dengan target masing-masing, dan
/// hasilnya disetor BERTAHAP oleh toko produksi -- tidak pernah sekali jadi.
/// Karena itu tidak ada "tipe produksi" (satu batch bisa mencampur tujuan) dan
/// tidak ada "toko tujuan" (hasilnya selalu mendarat di rumah produksi).
model Production {
  id         BigInt           @id @default(autoincrement())
  code       String           @unique @db.VarChar(100)
  status     ProductionStatus @default(PLANNED)
  targetDate DateTime
  notes      String?
  /// Batch ini melanjutkan sisa target batch sebelumnya yang ditutup lebih
  /// awal. Menjaga jejaknya, bukan memulai dari nol tanpa asal-usul.
  parentProductionId BigInt?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  parent   Production?  @relation("BatchLanjutan", fields: [parentProductionId], references: [id])
  children Production[] @relation("BatchLanjutan")

  items      ProductionItem[]
  deliveries ProductionDelivery[]

  @@index([parentProductionId])
  @@map("production")
}

/// Satu varian dalam batch, beserta target dan berapa yang sudah masuk.
model ProductionItem {
  id                BigInt @id @default(autoincrement())
  productionId      BigInt
  productVariantId  BigInt
  targetQuantity    Int
  /// Akumulasi dari seluruh setoran. Disimpan, bukan dihitung ulang tiap
  /// kali, supaya daftar batch tidak perlu menjumlah ribuan baris setoran.
  deliveredQuantity Int    @default(0)

  production Production     @relation(fields: [productionId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [productVariantId], references: [id])

  deliveryItems ProductionDeliveryItem[]

  @@unique([productionId, productVariantId])
  @@index([productVariantId])
  @@map("production_item")
}

/// Satu kali antar hasil produksi dari toko produksi ke toko utama.
model ProductionDelivery {
  id           BigInt   @id @default(autoincrement())
  productionId BigInt
  deliveredAt  DateTime
  /// Catatan dari toko produksi yang mengantar (hasil QC di tempat mereka).
  note         String?
  /// Admin yang mencatat setoran ini.
  userId       BigInt?
  createdAt    DateTime @default(now())

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  user       Users?     @relation(fields: [userId], references: [id])

  items ProductionDeliveryItem[]

  @@index([productionId])
  @@map("production_delivery")
}

model ProductionDeliveryItem {
  id               BigInt @id @default(autoincrement())
  deliveryId       BigInt
  productionItemId BigInt
  quantity         Int

  delivery ProductionDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item     ProductionItem     @relation(fields: [productionItemId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, productionItemId])
  @@map("production_delivery_item")
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ==================
// BLOG
// ==================

/// Tulisan di storefront. Isinya HTML dari editor berformat, jadi WAJIB
/// dibersihkan di server sebelum disimpan -- tanpa itu, siapa pun yang bisa
/// menulis blog bisa menitipkan skrip ke halaman publik.
model Blog {
  id          BigInt     @id @default(autoincrement())
  title       String     @db.VarChar(200)
  slug        String     @unique @db.VarChar(220)
  /// Kalimat pendek untuk kartu daftar dan deskripsi di hasil pencarian.
  /// Kosong berarti diambil otomatis dari awal tulisan.
  excerpt     String?    @db.VarChar(300)
  content     String
  coverImage  String?    @db.VarChar(500)
  /// Kata kunci untuk metadata halaman.
  keywords    String[]   @default([])
  status      BlogStatus @default(DRAFT)
  /// Diisi sekali saat pertama kali diterbitkan; dipakai mengurutkan daftar
  /// publik dan menampilkan tanggal tayang.
  publishedAt DateTime?
  categoryId  BigInt?
  /// Penulis, diambil dari token saat dibuat.
  userId      BigInt?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id])
  user     Users?        @relation(fields: [userId], references: [id])

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("blog")
}

model BlogCategory {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now())

  blogs Blog[]

  @@map("blog_category")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// ==================
// EXPENSE
// ==================

model ExpenseCategory {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  color       String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expenses    Expense[]

  @@map("expense_category")
}

model Expense {
  id          BigInt   @id @default(autoincrement())
  storeId     BigInt
  date        DateTime
  categoryId  BigInt
  description String?
  totalAmount Decimal
  /// Admin yang menginput pengeluaran ini. Diambil dari token, tidak pernah
  /// dari isian form -- itu yang membuatnya tidak bisa dimanipulasi.
  /// Kosong untuk data lama sebelum kolom ini ada.
  userId      BigInt?
  createdAt   DateTime @default(now())

  expenseCategory ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Sengaja TIDAK cascade: menghapus akun karyawan tidak boleh ikut
  /// menghapus pengeluarannya, karena angkanya sudah masuk laporan.
  user            Users?          @relation(fields: [userId], references: [id])

  expenseItem ExpenseItem[]
  proofs      ExpenseProof[]

  @@index([userId])
  @@map("expense")
}

/// Foto bukti pengeluaran (nota, struk, bukti transfer). Opsional: pengeluaran
/// tetap sah tanpa lampiran, jadi relasinya nol-ke-banyak, bukan wajib satu.
model ExpenseProof {
  id        BigInt   @id @default(autoincrement())
  expenseId BigInt
  /// URL Cloudinary. Menghapus pengeluaran ikut menghapus barisnya di sini,
  /// dan servicenya yang menghapus berkasnya di Cloudinary.
  image     String   @db.VarChar(500)
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_proof")
}

model ExpenseItem {
  id        BigInt  @id @default(autoincrement())
  expenseId BigInt
  itemName  String? @db.VarChar(100)
  quantity  Int
  unit      String  @db.VarChar(100)
  price     Decimal
  subtotal  Decimal

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_item")
}

// ==================
// E-COMMERCE & Be Spoke
// ==================

model Order {
  id                BigInt              @id @default(autoincrement())
  storeId           BigInt
  customerId        BigInt?
  orderId           String              @unique @db.VarChar(100)
  paymentMethodId   BigInt?
  paymentGatewayRef String?             @db.VarChar(255)
  status            OrderStatus
  deliveryMethod    OrderDeliveryMethod @default(SHIP)
  /// Jumlah referensi dari harga katalog saat pesanan diajukan -- dihitung
  /// sekali, tidak pernah diubah lagi. Murni pembanding "sebelum vs sesudah
  /// nego", bukan patokan harga final.
  estimatedTotal    Decimal
  /// Nominal DP yang sudah dibayar, diisi manual oleh admin setelah nego
  /// selesai di WA -- angka bebas, bukan hasil hitungan dari totalAmount.
  dpAmount          Decimal?
  /// Snapshot kontak pemesan. Diisi untuk tamu (tidak punya akun) maupun
  /// customer login, supaya admin tidak perlu join ke Customer hanya untuk
  /// tahu siapa yang harus dihubungi.
  buyerName         String?             @db.VarChar(150)
  buyerPhone        String?             @db.VarChar(30)
  /// Harga yang berlaku, bebas dinego dan ditimpa manual oleh admin --
  /// lepas sama sekali dari estimatedTotal.
  totalAmount       Decimal
  /// Kapan stok pesanan ini dikunci (dipindah dari stok bebas ke
  /// reserved_stock) saat ditandai Lunas. Kosong berarti stoknya belum pernah
  /// disentuh -- termasuk pesanan lama sebelum aturan ini ada, yang sengaja
  /// dibiarkan apa adanya: Selesai/Batal/Refund hanya mengembalikan atau
  /// mengeluarkan stok kalau kolom ini terisi.
  stockLockedAt     DateTime?
  /// Admin yang memproses pesanan ini (mencatat hasil nego, menutup pesanan).
  /// Kosong untuk pesanan lama yang tidak punya jejaknya -- sengaja dibiarkan
  /// kosong, bukan ditebak.
  userId            BigInt?
  createdAt         DateTime            @default(now())

  customer Customer?      @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  shipment Shipment?
  payment  PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  store    Store          @relation(fields: [storeId], references: [id])
  user     Users?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("order")
}

enum OrderStatus {
  PENDING
  /// DP sudah dibayar tapi belum lunas -- tahap baru untuk alur nego WA.
  DP
  /// Barang selesai diproduksi, tapi belum tentu lunas -- pemicu WA yang
  /// minta customer menyelesaikan pelunasan. Beda dari PAID: di sini uang
  /// belum tentu penuh, jadi TIDAK termasuk status "settled" (stok/kas/kuota
  /// belum boleh bergerak di titik ini).
  PRODUCTION_DONE
  PAID
  CANCELLED
  SHIPPED
  COMPLETED
  REFUNDED
}

enum OrderDeliveryMethod {
  SHIP
  PICKUP
}

model OrderItem {
  id               BigInt  @id @default(autoincrement())
  orderId          BigInt
  productVariantId BigInt
  quantity         Int
  price            Decimal
  subtotal         Decimal
  /// Permintaan custom per item (ubah warna, motif, dll), diisi customer
  /// saat mengajukan pesanan.
  notes            String? @db.VarChar(500)

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("order_item")
}

model Cart {
  id         BigInt   @id @default(autoincrement())
  customerId BigInt   @unique
  updateAt   DateTime @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  cartItems CartItem[]

  @@map("cart")
}

model CartItem {
  id               BigInt @id @default(autoincrement())
  cartId           BigInt
  productVariantId BigInt
  quantity         Int

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@map("cart_item")
}

model Wishlist {
  id              BigInt   @id @default(autoincrement())
  customerId      BigInt
  productMasterId BigInt
  createdAt       DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  ProductMaster @relation(fields: [productMasterId], references: [id])

  @@unique([customerId, productMasterId])
  @@map("wishlist")
}

/// Pesanan custom per pembeli -- dulu menempel pada Production sebagai
/// "tipe produksi BE_SPOKE". Dipisah karena alurnya memang lain: tidak pernah
/// menyentuh stok (tidak punya varian), dan justru mencatat kas MASUK sebesar
/// harga yang disepakati saat selesai.
model BespokeOrder {
  id          BigInt         @id @default(autoincrement())
  code        String         @unique @db.VarChar(100)
  customerId  BigInt?
  /// Produk katalog yang jadi dasar pesanan ini.
  ///
  /// Kosong berarti desainnya DI LUAR katalog, dan untuk itu berlaku jumlah
  /// minimum (lihat `BESPOKE_MIN_QUANTITY_CUSTOM` di paket schemas). Kalau
  /// terisi — termasuk ketika pembeli hanya minta ganti warna — jumlahnya
  /// bebas, karena polanya sudah kami punya.
  productMasterId BigInt?
  title       String         @db.VarChar(100)
  description String?
  quantity    Int            @default(1)
  quotedPrice Decimal        @db.Decimal(18, 2)
  status      BespokeStatus  @default(PLANNED)
  targetDate  DateTime
  notes       String?
  /// Diisi sekali saat status pertama kali jadi COMPLETED -- penanda bahwa
  /// kas masuknya sudah dicatat, supaya tidak tercatat dua kali.
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  customer      Customer?      @relation(fields: [customerId], references: [id])
  productMaster ProductMaster? @relation(fields: [productMasterId], references: [id])
  shipments     Shipment?

  @@index([customerId])
  @@index([productMasterId])
  @@map("bespoke_order")
}

enum BespokeStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CustomerAddress {
  id            BigInt  @id @default(autoincrement())
  customerId    BigInt
  recipientName String  @db.VarChar(100)
  phone         String  @db.VarChar(15)
  addressLine   String
  city          String  @db.VarChar(100)
  province      String  @db.VarChar(100)
  isDefault     Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_address")
}

model Shipment {
  id               BigInt          @id @default(autoincrement())
  orderId          BigInt?         @unique
  bespokeOrderId   BigInt?         @unique
  recipientName    String          @db.VarChar(255)
  phone            String          @db.VarChar(15)
  addressLine      String
  city             String          @db.VarChar(100)
  province         String          @db.VarChar(100)
  courier          String          @db.VarChar(100)
  trackingNumber   String?         @db.VarChar(100)
  status           ShipmentStatus? @default(PACKAGING)
  shippingCost     Decimal
  /// Tiga kolom berikut murni catatan admin soal paket -- seperti
  /// shippingCost, tidak menambah tagihan customer dan tidak menyentuh kas.
  /// Berat ditulis apa adanya ("15 Kg") karena satuannya ikut ditulis admin.
  totalWeight      String?         @db.VarChar(50)
  unitWeight       String?         @db.VarChar(50)
  /// Angka, bukan teks: harga per satuan bisa dijumlahkan dan dibandingkan.
  unitPrice        Decimal?        @db.Decimal(18, 2)
  createdAt        DateTime        @default(now())

  order          Order?          @relation(fields: [orderId], references: [id])
  bespokeOrder   BespokeOrder?   @relation(fields: [bespokeOrderId], references: [id])

  @@map("shipment")
}

enum ShipmentStatus {
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==================
// PAYMENT & FINANCE
// ==================

model PaymentMethod {
  id      BigInt         @id @default(autoincrement())
  name    String         @db.VarChar(100)
  channel PaymentChannel
  /// Toko pemilik metode ini. Kosong berarti berlaku di semua toko — dipakai
  /// untuk tunai, yang tidak pernah menyangkut rekening siapa pun.
  ///
  /// Rekening bank dan QRIS selalu milik satu toko: cabang berdiri sendiri dan
  /// uangnya harus mendarat di rekening mereka, bukan di rekening toko utama.
  /// Tanpa kolom ini kasir cabang ikut melihat rekening toko lain.
  storeId  BigInt?
  store    Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)

  orders                Order[]
  posTransactions       PosTransaction[]
  bankAccount           BankAccount?
  qrisAccount           QrisAccount?
  transferPaymentDetail TransferPaymentDetail[]

  @@index([storeId])
  @@map("payment_method")
}

/// Data QRIS tercetak milik satu metode pembayaran.
///
/// Dipisah dari `payment_method` dengan pola yang sama seperti `BankAccount`:
/// hanya channel tertentu yang punya detail ini, dan menaruhnya di tabel induk
/// berarti dua kolom yang selalu kosong untuk channel lain.
model QrisAccount {
  id              BigInt        @id @default(autoincrement())
  paymentMethodId BigInt        @unique
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  /// Nama merchant yang tertera di QR — dipakai kasir untuk memastikan
  /// pembeli memindai QR toko yang benar.
  merchantName    String        @db.VarChar(100)
  /// Gambar QR-nya (Cloudinary), ditampilkan di layar kasir.
  qrImage         String        @db.VarChar(255)

  @@map("qris_account")
}

model BankAccount {
  id              BigInt        @id @default(autoincrement())
  paymentMethodId BigInt        @unique
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  bankName        String        @db.VarChar(100) // "BNI", "BRI"
  accountNumber   String        @db.VarChar(50) // nomor rekening
  accountName     String        @db.VarChar(100) // nama pemilik rekening

  @@map("bank_account")
}

enum PaymentChannel {
  CASH
  MIDTRANS
  BANK_TRANSFER
  /// QRIS tercetak milik toko, ditempel di meja kasir.
  ///
  /// Berbeda dari MIDTRANS yang membuat QR dinamis berisi nominal dan
  /// mendeteksi pelunasan sendiri: yang ini tidak tahu apa-apa soal
  /// pembayaran, jadi kasir yang memastikan lalu mengunggah buktinya —
  /// alurnya sama persis dengan transfer bank.
  QRIS_STATIC
}

model CashTransaction {
  id          BigInt     @id @default(autoincrement())
  storeId     BigInt
  type        CashType
  amount      Decimal
  source      CashSource
  referenceId BigInt
  note        String?
  createdAt   DateTime   @default(now())

  store Store @relation(fields: [storeId], references: [id])

  /**
   * Dulu `@@unique([referenceId, source])` — satu baris kas per acuan.
   *
   * Pesanan nego membayar bertahap (DP dulu, pelunasan belakangan, kadang
   * berbulan kemudian), dan tiap pembayaran harus jadi barisnya sendiri supaya
   * laporan kas bulanan mencerminkan uang yang benar-benar masuk pada bulan
   * itu. Menumpuknya jadi satu baris yang di-update berarti seluruh nilainya
   * ikut pindah ke bulan DP — dan laporan bulan yang sudah lewat berubah
   * sendiri.
   *
   * Penjagaan duplikat untuk sumber lain TIDAK hilang: digantikan partial
   * unique index `WHERE source <> 'ORDER'` yang dibuat manual di migrasi
   * 20260916_cash_transaction_allow_installments. Prisma belum bisa
   * mendeklarasikan partial index, jadi hanya indeks biasa yang tertulis di
   * sini.
   */
  @@index([referenceId, source])
  @@map("cash_transaction")
}

enum CashType {
  IN
  OUT
}

enum CashSource {
  POS
  ORDER
  EXPENSE
  PRODUCTION
  /// Pesanan custom. Dipisah dari PRODUCTION supaya laporan bisa
  /// membedakan uang penjualan dari sekadar mutasi produksi.
  BESPOKE
}

model TransferPaymentDetail {
  id              BigInt         @id @default(autoincrement())
  transactionId   BigInt         @unique
  transaction     PosTransaction @relation(fields: [transactionId], references: [id])
  paymentMethodId BigInt?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  paymentProof    String?        @db.VarChar(255)
  confirmedAt     DateTime?

  @@map("transfer_payment_detail")
}

// ==================
// POS (OFFLINE SALES)
// ==================

model PosTransaction {
  id              BigInt    @id @default(autoincrement())
  storeId         BigInt
  cashierId       BigInt
  transId         String    @unique @db.VarChar(100)
  paymentMethodId BigInt?
  status          PosStatus
  totalAmount     Decimal
  createdAt       DateTime  @default(now())

  store         Store          @relation(fields: [storeId], references: [id])
  users         Users          @relation(fields: [cashierId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  items                 PosTransactionItem[]
  transferPaymentDetail TransferPaymentDetail?

  @@map("pos_transaction")
}

enum PosStatus {
  PENDING
  PARKED
  PAID
  CANCELLED
}

model PosTransactionItem {
  id               BigInt  @id @default(autoincrement())
  posTransactionId BigInt
  productVariantId BigInt
  quantity         Int
  price            Decimal
  subtotal         Decimal

  posTransaction PosTransaction @relation(fields: [posTransactionId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([posTransactionId, productVariantId])
  @@map("pos_transaction_item")
}
